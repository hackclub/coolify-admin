<div class="page-header">
  <h1>Coolify Admin - Resource Monitor</h1>
  <div class="header-actions">
    <%= link_to "Add New Team", new_coolify_team_path, class: "btn btn-primary" %>
    <button id="sync-btn" class="btn btn-secondary">🔄 Sync Coolify Data</button>
    <button id="collect-btn" class="btn btn-secondary">📊 Collect Metrics Now</button>
  </div>
</div>

<div id="sync-status" class="sync-status" style="display: none;"></div>

<!-- View Controls -->
<div class="view-controls">
  <div class="view-switcher">
    <%= link_to "🌳 Tree View", root_path(view: 'tree', server_id: @server_id), 
        class: "view-btn #{@view == 'tree' ? 'active' : ''}" %>
    <%= link_to "💾 Storage View", root_path(view: 'storage', server_id: @server_id), 
        class: "view-btn #{@view == 'storage' ? 'active' : ''}" %>
    <%= link_to "⚡ CPU View", root_path(view: 'cpu', server_id: @server_id), 
        class: "view-btn #{@view == 'cpu' ? 'active' : ''}" %>
    <%= link_to "🧠 RAM View", root_path(view: 'ram', server_id: @server_id), 
        class: "view-btn #{@view == 'ram' ? 'active' : ''}" %>
    <%= link_to "🧟 Zombies View", root_path(view: 'zombies', server_id: @server_id), 
        class: "view-btn #{@view == 'zombies' ? 'active' : ''}" %>
  </div>
  
  <div class="filter-controls">
    <%= form_with url: root_path, method: :get, class: "server-filter-form" do |f| %>
      <%= f.hidden_field :view, value: @view %>
      <%= f.select :server_id, 
          options_for_select([['All Servers', '']] + @servers.map { |s| [s.name, s.id] }, @server_id),
          {},
          class: "server-filter-select",
          onchange: "this.form.submit()" %>
    <% end %>
  </div>
</div>

<% if @coolify_teams.empty? %>
  <div class="empty-state">
    <p>No teams configured yet.</p>
    <p><%= link_to "Add your first team", new_coolify_team_path %> to get started.</p>
  </div>
<% else %>
  <!-- Summary Stats -->
  <div class="stats-summary">
    <div class="stat-card">
      <div class="stat-value"><%= @stats[:servers] %></div>
      <div class="stat-label">Servers</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @stats[:projects] %></div>
      <div class="stat-label">Projects</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @stats[:environments] %></div>
      <div class="stat-label">Environments</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @stats[:applications] %></div>
      <div class="stat-label">Applications</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @stats[:services] %></div>
      <div class="stat-label">Services</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= @stats[:databases] %></div>
      <div class="stat-label">Databases</div>
    </div>
  </div>

  <% if @view == 'tree' %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    
    <% @coolify_teams.each do |team| %>
      <div class="team-section mb-8">
        <h2 class="text-lg font-bold mb-4 text-gray-700"><%= team.name %></h2>
        
        <div class="server-grid">
          <% team.servers.each do |server| %>
            <% latest = @latest_server_stats[server.id] %>
            <div class="server-card">
              <div class="server-card-header">
                <div>
                  <div class="server-card-title">
                    <%= link_to server.name, server_path(server) %>
                  </div>
                  <div class="server-card-subtitle">
                    <%= server.ip %>:<%= server.port %>
                  </div>
                </div>
                <% if server.is_reachable %>
                  <span class="badge badge-success">Online</span>
                <% else %>
                  <span class="badge badge-error">Offline</span>
                <% end %>
              </div>
              
              <div class="server-card-body">
                <!-- Mini Charts -->
                <div class="server-charts-container">
                  <div class="mini-chart-box">
                    <span class="mini-chart-label">CPU</span>
                    <div class="mini-chart-canvas-wrapper">
                      <canvas id="cpu-<%= server.id %>"></canvas>
                    </div>
                    <div class="text-xs text-right font-mono mt-1" style="font-size: 0.7rem; text-align: right; font-family: monospace; margin-top: 0.25rem;">
                      <%= latest&.cpu_pct&.round(0) || 0 %>%
                    </div>
                  </div>
                  <div class="mini-chart-box">
                    <span class="mini-chart-label">RAM</span>
                    <div class="mini-chart-canvas-wrapper">
                      <canvas id="ram-<%= server.id %>"></canvas>
                    </div>
                    <div class="text-xs text-right font-mono mt-1" style="font-size: 0.7rem; text-align: right; font-family: monospace; margin-top: 0.25rem;">
                      <%= latest&.mem_pct&.round(0) || 0 %>%
                    </div>
                  </div>
                </div>
                
                <div class="text-xs text-gray-500 mt-2" style="font-size: 0.75rem; color: #6b7280; margin-top: 0.5rem;">
                  Resources: <%= server.resources.count %> 
                  (Apps: <%= server.resources.select { |r| r.type == 'Application' }.count %>, 
                   DBs: <%= server.resources.select { |r| r.type == 'CoolifyDatabase' }.count %>)
                </div>
              </div>
              
              <!-- Footer Stats -->
              <div class="server-stats-row">
                <div class="stat-badge">
                  <% if latest && latest.disk_used_bytes && latest.disk_total_bytes %>
                    <% disk_pct = (latest.disk_used_bytes.to_f / latest.disk_total_bytes) * 100 %>
                    <span class="stat-dot <%= disk_pct > 85 ? 'red' : 'green' %>"></span>
                    Disk: <%= format_disk_stat(latest) %>
                  <% else %>
                    <span class="stat-dot"></span>
                    Disk: N/A
                  <% end %>
                </div>
                <div class="stat-badge">
                  Load: <%= latest&.load1&.round(2) || '-' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Script to Init Charts -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const commonOptions = {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          scales: {
            x: { display: false },
            y: { display: false, min: 0, max: 100 }
          },
          elements: {
            point: { radius: 0 },
            line: { borderWidth: 2, tension: 0.3 }
          }
        };

        const serverData = {
          <% @coolify_teams.flat_map(&:servers).each do |server| %>
            <%= server.id %>: {
              timestamps: <%= raw (@server_histories[server.id] || []).map { |s| s.captured_at.to_i * 1000 }.to_json %>,
              cpu: <%= raw (@server_histories[server.id] || []).map { |s| s.cpu_pct }.to_json %>,
              ram: <%= raw (@server_histories[server.id] || []).map { |s| s.mem_pct }.to_json %>
            },
          <% end %>
        };

        for (const [serverId, data] of Object.entries(serverData)) {
          if (!data.timestamps || data.timestamps.length === 0) continue;

          // CPU Chart
          const cpuCtx = document.getElementById(`cpu-${serverId}`);
          if (cpuCtx) {
            new Chart(cpuCtx, {
              type: 'line',
              data: {
                labels: data.timestamps,
                datasets: [{
                  data: data.cpu,
                  borderColor: '#ef4444',
                  backgroundColor: 'rgba(239, 68, 68, 0.1)',
                  fill: true
                }]
              },
              options: commonOptions
            });
          }

          // RAM Chart
          const ramCtx = document.getElementById(`ram-${serverId}`);
          if (ramCtx) {
            new Chart(ramCtx, {
              type: 'line',
              data: {
                labels: data.timestamps,
                datasets: [{
                  data: data.ram,
                  borderColor: '#8b5cf6',
                  backgroundColor: 'rgba(139, 92, 246, 0.1)',
                  fill: true
                }]
              },
              options: commonOptions
            });
          }
        }
      });
    </script>
  
  <% elsif @view == 'storage' %>
    <!-- Storage View: Resources sorted by disk usage -->
    <div class="storage-view">
      <div class="storage-header">
        <h2>Resources by Storage Usage</h2>
        <% if @server_id.present? && (filtered_server = @servers.find { |s| s.id.to_s == @server_id.to_s }) %>
          <span class="filter-badge">Filtered: <%= filtered_server.name %></span>
        <% end %>
      </div>
      
      <div class="storage-list">
        <% if @resources_by_storage.any? %>
          <table class="storage-table">
            <thead>
              <tr>
                <th>Resource</th>
                <th>Type</th>
                <th>Server</th>
                <th>Project / Environment</th>
                <th>Status</th>
                <th>Disk Usage</th>
                <th>Memory</th>
                <th>CPU</th>
              </tr>
            </thead>
            <tbody>
              <% @resources_by_storage.each do |resource| %>
                <% rstat = @latest_resource_stats[resource.id] %>
                <% total_disk = rstat ? (rstat.disk_runtime_bytes.to_i + rstat.disk_persistent_bytes.to_i) : 0 %>
                <tr class="storage-row">
                  <td class="resource-name">
                    <div class="resource-name-row">
                      <strong><%= link_to resource.name, resource_path(resource), class: "resource-detail-link" %></strong>
                      <% if resource.coolify_url %>
                        <a href="<%= resource.coolify_url %>" target="_blank" rel="noopener" class="coolify-chevron" title="Open in Coolify">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"></path></svg>
                        </a>
                      <% end %>
                    </div>
                    <% if resource.metadata.dig('raw', 'fqdn').present? %>
                      <div class="resource-url">
                        <a href="<%= resource.metadata.dig('raw', 'fqdn').split(',').first %>" target="_blank" rel="noopener">
                          <%= resource.metadata.dig('raw', 'fqdn').split(',').first %>
                        </a>
                      </div>
                    <% end %>
                  </td>
                  <td>
                    <span class="resource-type-badge <%= resource.type.downcase %>">
                      <%= resource.type.sub('Coolify', '').downcase %>
                    </span>
                  </td>
                  <td class="server-name"><%= resource.server.name %></td>
                  <td class="project-env">
                    <%= resource.environment.project.name %>
                    <span class="env-name">/ <%= resource.environment.name %></span>
                  </td>
                  <td>
                    <% if resource.status.present? %>
                      <% status_class = resource.status.start_with?('running') ? 'ok' : 'err' %>
                      <span class="status <%= status_class %>"><%= resource.status %></span>
                    <% end %>
                  </td>
                  <td class="disk-usage">
                    <% if total_disk > 0 %>
                      <strong><%= format_bytes(total_disk) %></strong>
                      <div class="disk-breakdown">
                        <span class="disk-part">RW: <%= format_bytes(rstat.disk_runtime_bytes || 0) %></span>
                        <span class="disk-part">Vol: <%= format_bytes(rstat.disk_persistent_bytes || 0) %></span>
                      </div>
                    <% else %>
                      <span class="no-data">No data</span>
                    <% end %>
                  </td>
                  <td class="memory-stat">
                    <% if rstat %>
                      <%= format_memory_stat(rstat) %>
                    <% else %>
                      <span class="no-data">-</span>
                    <% end %>
                  </td>
                  <td class="cpu-stat">
                    <% if rstat&.cpu_pct %>
                      <%= rstat.cpu_pct.round(1) %>%
                    <% else %>
                      <span class="no-data">-</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="empty-state">
            <p>No resources found.</p>
            <% if @server_id.present? %>
              <p><%= link_to "Clear filter", root_path(view: 'storage') %> to see all resources.</p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  
